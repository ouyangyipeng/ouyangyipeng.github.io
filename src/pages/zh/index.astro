---
import { getSiteConfig } from "../../config";
import ThemeInit from "../../components/ThemeInit.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import About from "../../components/About.astro";
import OpenSourceProjects from "../../components/OpenSourceProjects.astro";
import Research from "../../components/Research.astro";
import Journey from "../../components/Journey.astro";
import Awards from "../../components/Awards.astro";
import Footer from "../../components/Footer.astro";
import "../../styles/global.css";

const lang = "zh";
const siteConfig = getSiteConfig(lang);
const pageTitle = `${siteConfig.personal.name} — ${siteConfig.personal.title}`;
const canonicalUrl = "https://oyyp.nexa-lang.com/zh/";
---

<html lang="zh-CN">
  <head>
    <ThemeInit />
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/images/nexa-logo-noframe.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={siteConfig.personal.description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={siteConfig.personal.description} />
    <meta property="og:image" content="https://oyyp.nexa-lang.com/images/nexa-logo-noframe.png" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={siteConfig.personal.description} />

    <!-- Alternate language -->
    <link rel="alternate" hreflang="en" href="https://oyyp.nexa-lang.com" />
    <link rel="alternate" hreflang="zh-CN" href={canonicalUrl} />

    <!-- RSS -->
    <link rel="alternate" type="application/rss+xml" title="欧阳易芃 — 博客" href="https://oyyp.nexa-lang.com/rss.xml" />

    <!-- Theme color for dark mode -->
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <Header lang={lang} />
    <main id="main">
      <Hero lang={lang} />
      <About lang={lang} />
      <Journey lang={lang} />
      <OpenSourceProjects lang={lang} />
      <Research lang={lang} />
      <Awards lang={lang} />
    </main>
    <Footer lang={lang} />
  </body>
</html>
