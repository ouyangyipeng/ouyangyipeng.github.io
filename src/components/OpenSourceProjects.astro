---
import { getProjects } from "../config/projects";
import { ui } from "../i18n/ui";
import type { Lang } from "../config/types";
import NexaEcosystem from "./NexaEcosystem.astro";
import Projects from "./Projects.astro";

interface Props { lang: Lang; }
const { lang } = Astro.props;
const projects = getProjects(lang).filter(project => project.presentation === "featured");
const t = ui[lang];
---

<section id="open-source" class="section open-source" aria-labelledby="open-source-title">
  <div class="site-container">
    <div class="section-heading">
      <span class="section-index" aria-hidden="true">03</span>
      <h2 id="open-source-title" class="section-title">{t.sectionOpenSource}</h2>
    </div>
    <NexaEcosystem lang={lang} />
    <div class="featured-projects">
      {projects.map(project => (
        <article class="featured-project">
          <div class="project-heading">
            {project.logo && <img src={project.logo} alt="" width="64" height="64" loading="lazy" />}
            <div>
              {project.role && <p class="project-role">{project.role}</p>}
              <h3>{project.name}</h3>
            </div>
          </div>
          <p class="project-description">{project.description}</p>
          {project.level && <p class="project-level">{project.level}</p>}
          <ul class="project-skills" role="list">{project.skills.map(skill => <li>{skill}</li>)}</ul>
          <div class="project-actions">
            {project.homepage && <a class="text-link" href={project.homepage} target="_blank" rel="noopener noreferrer">{lang === "en" ? "Explore project" : "项目主页"}<span aria-hidden="true">↗</span></a>}
            {project.link && <a class="text-link" href={project.link} target="_blank" rel="noopener noreferrer">GitHub<span aria-hidden="true">↗</span></a>}
          </div>
        </article>
      ))}
    </div>
    <Projects lang={lang} />
  </div>
</section>

<style>
  .open-source { background: linear-gradient(125deg, var(--bg-secondary), var(--bg-primary) 75%); }
  .featured-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 64px; margin-top: 72px; }
  .featured-project { display: grid; grid-template-rows: 72px 1fr auto auto auto; align-items: start; border-top: 1px solid var(--border-primary); padding-top: 36px; min-width: 0; }
  .project-heading { display: flex; align-items: center; gap: 20px; min-height: 72px; }
  .project-heading img { display: block; width: 64px; height: 64px; flex-shrink: 0; box-sizing: border-box; padding: 6px; object-fit: contain; object-position: center; border-radius: 8px; background: #fff; }
  .project-heading h3 { margin: 0; color: var(--text-primary); font-size: clamp(23px, 2.3vw, 29px); font-weight: 600; letter-spacing: -.04em; line-height: 1.3; overflow-wrap: anywhere; }
  .project-role { margin: 0 0 7px; font: 11px/1.6 var(--font-mono); color: var(--text-tertiary); }
  .project-description { font-size: 16px; line-height: 1.85; margin: 28px 0 18px; }
  .project-level { color: var(--accent-color); font-size: 13px; line-height: 1.7; margin: 0 0 20px; }
  .project-skills { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 0; padding: 0; list-style: none; font: 11px/1.7 var(--font-mono); color: var(--text-tertiary); }
  .project-actions { display: flex; flex-wrap: wrap; gap: 24px; margin-top: 26px; font-size: 13px; }
  @media (max-width: 760px) {
    .featured-projects { grid-template-columns: 1fr; gap: 40px; margin-top: 48px; }
    .featured-project { padding-top: 28px; }
    .project-heading { gap: 16px; }
    .project-heading img { width: 52px; height: 52px; }
    .project-description { margin-top: 20px; }
  }
</style>
