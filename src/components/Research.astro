---
import { getSiteConfig } from "../config";
import { ui } from "../i18n/ui";
import type { Lang } from "../config/types";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { research } = getSiteConfig(lang);
const t = ui[lang];
const papers = [...research.filter(paper => paper.pinned), ...research.filter(paper => !paper.pinned)];
function statusLabel(status: string): string {
  if (status === "accepted") return t.statusAccepted;
  if (status === "submitting") return t.statusSubmitting;
  return t.statusPreprint;
}
---
<section id="research" class="section">
  <div class="site-container">
    <div class="section-heading"><span class="section-index" aria-hidden="true">04</span><h2 class="section-title">{t.sectionResearch}</h2></div>
    <div class="papers">
      {papers.map((paper, index) => (
        <article class:list={["paper", {"paper-featured": paper.pinned}]}>
          <div class="paper-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}<span></span></div>
          <div class="paper-content">
            <div class="paper-meta">
              {paper.status && <span class:list={["paper-status", paper.status]}><i aria-hidden="true"></i>{statusLabel(paper.status)}</span>}
              <span>{paper.venue}</span>
              {paper.level && <span>{paper.level}</span>}
            </div>
            <h3>{paper.link ? <a href={paper.link} target="_blank" rel="noopener noreferrer">{paper.title}<span class="external" aria-hidden="true">↗</span></a> : paper.title}</h3>
            <p class="paper-authors">{paper.authors}</p>
            {paper.contribution && <p class="paper-contribution">{paper.contribution}</p>}
            <div class="paper-details">
              {paper.myRole && <span class="paper-role">{paper.myRole}</span>}
              {paper.dois?.map(doi => <a class="doi-link" href={`https://doi.org/${doi}`} target="_blank" rel="noopener noreferrer">{t.doiLabel}: {doi} ↗</a>)}
              {paper.link && <a class="text-link" href={paper.link} target="_blank" rel="noopener noreferrer">{lang === "zh" ? "查看研究" : "View research"}<span aria-hidden="true">↗</span></a>}
            </div>
            {paper.creditRoles?.length && <p class="paper-credits">{t.creditLabel}: {paper.creditRoles.join(", ")}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
<style>
  .papers { border-top: 1px solid var(--border-primary); }
  .paper { display: grid; grid-template-columns: 80px minmax(0, 1fr); gap: 28px; padding-block: 38px; border-bottom: 1px solid var(--border-primary); }
  .paper-number { display: flex; align-items: center; align-self: start; gap: 16px; padding-top: 6px; font: 12px var(--font-mono); color: var(--text-tertiary); }
  .paper-number span { width: 24px; height: 1px; background: var(--border-primary); }
  .paper-featured .paper-number { color: var(--accent-color); }
  .paper-featured .paper-number span { background: var(--accent-color); }
  .paper-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; color: var(--text-tertiary); font: 12px/1.7 var(--font-mono); margin-bottom: 12px; }
  .paper-status { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; color: var(--text-secondary); }
  .paper-status i { width: 5px; height: 5px; border-radius: 50%; background: var(--accent-color); }
  .paper-status.accepted i { background: #179365; }
  .paper-status.submitting i { background: #bd8a26; }
  h3 { margin: 0; max-width: 50ch; font-size: clamp(19px, 2.1vw, 25px); font-weight: 600; color: var(--text-primary); line-height: 1.45; letter-spacing: -.025em; }
  h3 a { color: inherit; text-decoration: none; transition: color .2s; }
  h3 a:hover { color: var(--accent-color); }
  .external { color: var(--accent-color); font-size: 17px; display: inline-block; margin-left: 10px; }
  .paper-authors { color: var(--text-tertiary); font-size: 14px; margin: 12px 0 0; }
  .paper-contribution { max-width: 80ch; font-size: 15px; line-height: 1.8; color: var(--text-secondary); margin: 18px 0 0; }
  .paper-details { display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px 22px; margin-top: 20px; font-size: 12px; }
  .paper-role { color: var(--text-primary); font-weight: 600; }
  .doi-link { color: var(--text-tertiary); font-family: var(--font-mono); overflow-wrap: anywhere; }
  .paper-credits { color: var(--text-tertiary); font-size: 12px; margin-top: 14px; }
  @media (max-width: 640px) { .paper { grid-template-columns: 1fr; gap: 16px; padding-block: 30px; } .paper-number { padding: 0; } .paper-meta { font-size: 11px; } }
</style>
