---
import { getSiteConfig } from "../config";
import { ui } from "../i18n/ui";
import type { Lang } from "../config/types";
interface Props { lang: Lang; }
const { lang } = Astro.props;
const { personal, nexa } = getSiteConfig(lang);
const t = ui[lang];
const socialLinks = [["Email", `mailto:${personal.social.email}`], ["GitHub", personal.social.github], ["ORCID", personal.social.orcid], ["Google Scholar", personal.social.googleScholar]].filter((entry): entry is [string, string] => Boolean(entry[1]));
---
<footer class="site-footer">
  <div class="site-container">
    <div class="footer-main">
      <div><a class="footer-name" href="#hero">{personal.name}<span>.</span></a><p>{personal.title}</p></div>
      <div class="footer-social">{socialLinks.map(([label, href]) => <a class="text-link" href={href}>{label}<span aria-hidden="true">↗</span></a>)}</div>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} {personal.name}</span>
      <nav aria-label={lang === "zh" ? "页脚导航" : "Footer navigation"}>
        <a href={lang === "zh" ? "/zh/blog/" : "/blog/"}>{t.navBlog}</a>
        <a href={nexa.github}>Nexa GitHub</a>
        <a href={nexa.docs}>{lang === "zh" ? "Nexa 文档" : "Nexa Docs"}</a>
        <a href={lang === "zh" ? "/" : "/zh/"}>{t.langSwitchLabel}</a>
      </nav>
      <span class="footer-built">{t.footerBuilt}</span>
    </div>
  </div>
</footer>
<style>
  .site-footer { background: var(--bg-secondary); padding-block: 64px 28px; border-top: 1px solid var(--border-primary); }
  .footer-main { display: flex; justify-content: space-between; align-items: center; gap: 40px; padding-bottom: 50px; }
  .footer-name { font: 500 clamp(24px, 3vw, 36px)/1.2 var(--font-mono); letter-spacing: -.06em; color: var(--text-primary); text-decoration: none; }
  .footer-name span { color: var(--accent-color); }
  .footer-main p { font-size: 13px; color: var(--text-tertiary); margin: 16px 0 0; }
  .footer-social { display: flex; flex-wrap: wrap; gap: 28px; font-size: 13px; }
  .footer-bottom { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 18px 30px; padding-top: 24px; border-top: 1px solid var(--border-primary); font-size: 11px; color: var(--text-tertiary); }
  .footer-bottom nav { display: flex; gap: 20px; flex-wrap: wrap; }
  .footer-bottom a { color: inherit; text-decoration: none; }.footer-bottom a:hover { color: var(--accent-color); }
  @media (max-width: 760px) { .footer-main { align-items: flex-start; flex-direction: column; gap: 30px; }.site-footer { padding-top: 48px; }.footer-bottom { flex-direction: column; gap: 18px; }.footer-social { gap: 24px; } }
</style>
