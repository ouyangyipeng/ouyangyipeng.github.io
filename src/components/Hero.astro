---
import { getSiteConfig } from "../config";
import HeroParticles from "./HeroParticles.astro";
import { ui } from "../i18n/ui";
import type { Lang } from "../config/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const siteConfig = getSiteConfig(lang);
const t = ui[lang];
---

<section id="hero" class="hero">
  <div class="hero-atmosphere" aria-hidden="true"></div>
  <HeroParticles />
  <div class="site-container hero-content">
    <h2 class="hero-greeting animate-fade-in">{t.heroGreeting}</h2>
    <h1 class="hero-name animate-fade-in animation-delay-200">{t.heroIm} <span>{siteConfig.personal.name}</span></h1>
    <p class="hero-title animate-fade-in animation-delay-400">{siteConfig.personal.title}</p>
  </div>
  <div
    class="site-container hero-social animate-fade-in animation-delay-600"
  >
    <a
      href={`mailto:${siteConfig.personal.social.email}`}
      aria-label="Email"
      class="transition-colors duration-300 hover:text-[var(--accent-color)]"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
        <path d="M3 7l9 6l9 -6"></path>
      </svg>
    </a>
    {siteConfig.personal.social.github && (
      <a
        href={siteConfig.personal.social.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="transition-colors duration-300 hover:text-[var(--accent-color)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.928-.399 2.929-.399 1.001 0 2.007.134 2.929.399 3.293-1.552 3.301-1.23 3.301-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-3.807 5.624-5.479 5.919.43.372.823 1.102.823 2.222v3.293c0 .719.481 1.278 1.229 1.078 4.771-1.586 8.207-5.086 8.207-11.388 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
    )}
    {siteConfig.personal.social.orcid && (
      <a
        href={siteConfig.personal.social.orcid}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="ORCID"
        class="transition-colors duration-300 hover:text-[var(--accent-color)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8">
          <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.411c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.736 3.861h1.473v10.159H6.633V8.272zm3.947 0h3.947c3.736 0 5.473 2.625 5.473 5.078 0 2.625-1.847 5.078-5.473 5.078h-3.947V8.272zm1.473 1.578v7.922h2.474c2.105 0 3.473-1.578 3.473-3.947 0-2.263-1.368-3.947-3.473-3.947h-2.474z"/>
        </svg>
      </a>
    )}
    {siteConfig.personal.social.website && (
      <a
        href={siteConfig.personal.social.website}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Website"
        class="transition-colors duration-300 hover:text-[var(--accent-color)]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0"></path>
          <path d="M3.6 9h16.8"></path>
          <path d="M3.6 15h16.8"></path>
          <path d="M12 3a15 15 0 0 0 4 9a15 15 0 0 1 -4 9a15 15 0 0 1 -4 -9a15 15 0 0 0 4 -9"></path>
        </svg>
      </a>
    )}
    {siteConfig.personal.social.googleScholar && (
      <a
        href={siteConfig.personal.social.googleScholar}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Google Scholar"
        class="transition-colors duration-300 hover:text-[var(--accent-color)]"
      >
        <span aria-hidden="true" class="google-mark h-6 w-6 sm:h-7 sm:w-7 md:h-8 md:w-8"></span>
      </a>
    )}
  </div>
  <a class="hero-scroll" href="#about" aria-label={lang === "zh" ? "向下了解更多" : "Explore below"}><span aria-hidden="true">↓</span></a>
</section>
<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; min-height: 100svh; display: flex; align-items: center; padding-block: 160px 180px; background: var(--bg-primary); }
  .hero-atmosphere { position: absolute; inset: 0; z-index: -2; background: radial-gradient(ellipse at 0% 15%, var(--hero-glow), transparent 65%), radial-gradient(ellipse at 90% 65%, var(--hero-glow-secondary), transparent 45%); mask-image: linear-gradient(to bottom, black 75%, transparent); }
  .hero-content { z-index: 1; }
  .hero-greeting { font: 500 clamp(24px, 3vw, 42px)/1.3 var(--font-mono); letter-spacing: -.05em; color: var(--text-secondary); margin: 0 0 30px; }
  .hero-name { font: 600 clamp(42px, 7.4vw, 96px)/1.16 var(--font-mono); letter-spacing: -.07em; color: var(--text-primary); max-width: 1100px; margin: 0; text-wrap: balance; }
  .hero-name span { color: var(--accent-color); }
  .hero-title { font: 400 clamp(14px, 1.5vw, 19px)/1.8 var(--font-mono); color: var(--text-secondary); margin: 32px 0 0; max-width: 65ch; }
  .hero-social { position: absolute; bottom: 72px; inset-inline: 0; display: flex; gap: 28px; align-items: center; color: var(--text-secondary); z-index: 1; }
  .hero-social a { display: inline-flex; flex: 0 0 auto; min-width: 24px; min-height: 40px; padding-block: 8px; }
  .google-mark { display: block; background: currentColor; mask: url('/images/organizations/google-g.png') center / contain no-repeat; }
  .hero-scroll { position: absolute; bottom: 76px; right: max(40px, calc((100% - 1160px) / 2)); border: 1px solid var(--border-primary); border-radius: 50%; width: 48px; height: 48px; display: grid; place-items: center; color: var(--text-secondary); text-decoration: none; transition: background .2s, transform .2s; z-index: 1; }
  .hero-scroll:hover { background: var(--accent-soft); transform: translateY(3px); }
  @keyframes fade-in { from { opacity: 0; transform: translateY(32px); } to { opacity: 1; transform: translateY(0); } }
  .animate-fade-in { animation: fade-in .9s cubic-bezier(.16, 1, .3, 1) both; }
  .animation-delay-200 { animation-delay: .2s; }
  .animation-delay-400 { animation-delay: .4s; }
  .animation-delay-600 { animation-delay: .6s; }
  @media (max-width: 640px) {
    .hero { min-height: 100svh; padding-block: 150px 170px; }
    .hero-greeting { margin-bottom: 24px; }
    .hero-name { font-size: clamp(34px, 10.6vw, 58px); }
    .hero-title { margin-top: 24px; }
    .hero-social { bottom: 54px; gap: clamp(16px, 4vw, 24px); }
    .hero-scroll { bottom: 54px; right: 24px; width: 40px; height: 40px; }
  }
</style>
