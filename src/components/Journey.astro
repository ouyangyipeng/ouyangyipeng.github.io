---
import { getJourney } from "../config/journey";
import type { Lang } from "../config/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const journey = getJourney(lang);
---

<section id="experience" class="section" aria-labelledby="experience-title">
  <div class="site-container">
    <div class="section-heading">
      <span class="section-index" aria-hidden="true">02</span>
      <h2 id="experience-title" class="section-title">{journey.title}</h2>
    </div>
    <div class="journey-groups">
      {journey.groups.map((group) => (
        <section id={group.id === "academia" ? "education" : group.id === "service" ? "service" : undefined} class="journey-group" aria-labelledby={`experience-${group.id}`}>
          <h3 id={`experience-${group.id}`} class="group-title">{group.title}</h3>
          <ol class="journey-list" role="list">
            {group.entries.map((entry, entryIndex) => (
              <li class="journey-entry">
                <div class="organization-logos">
                  {entry.logos.map((logo, logoIndex) => {
                    const clipId = `logo-clip-${group.id}-${entryIndex}-${logoIndex}`;
                    const [x, y, width, height] = logo.artwork?.viewBox.split(" ") ?? [];
                    return (
                    <div class:list={["logo-surface", { "logo-surface-round": logo.shape === "round", "logo-surface-wide": logo.shape === "wide" }]}>
                      {logo.artwork ? (
                        <svg class="organization-logo" viewBox={logo.artwork.viewBox} role="img" aria-label={logo.alt} preserveAspectRatio="xMidYMid meet">
                          <defs>
                            <clipPath id={clipId}>
                              <rect x={x} y={y} width={width} height={height} />
                            </clipPath>
                          </defs>
                          <image href={logo.src} width={logo.artwork.width} height={logo.artwork.height} clip-path={`url(#${clipId})`} />
                        </svg>
                      ) : <img src={logo.src} alt={logo.alt} width="72" height="72" loading="lazy" decoding="async" />}
                    </div>
                    );
                  })}
                </div>
                <div class="entry-content">
                  <div class="entry-heading">
                    <h4 class="organization-name">
                      {entry.link ? (
                        <a href={entry.link} target="_blank" rel="noopener noreferrer">{entry.organization}</a>
                      ) : entry.organization}
                    </h4>
                    {entry.dateRange && <p class="entry-date">{entry.dateRange}</p>}
                  </div>
                  {entry.affiliation && <p class="entry-affiliation">{entry.affiliation}</p>}
                  {entry.role && <p class="entry-role">{entry.role}</p>}
                  {entry.contact && (
                    <p class="entry-contact">
                      <span>{entry.contact.label}: </span>
                      {entry.contact.link ? (
                        <a class="text-link" href={entry.contact.link} target="_blank" rel="noopener noreferrer">{entry.contact.name}<span aria-hidden="true">↗</span></a>
                      ) : entry.contact.name}
                    </p>
                  )}
                  {entry.details && (
                    <details class="academic-details">
                      <summary>{entry.details.label}</summary>
                      <ul class="entry-details" role="list">
                        {entry.details.items.map((item) => <li>{item}</li>)}
                      </ul>
                    </details>
                  )}
                  {entry.programs && (
                    <ol class="academic-programs" role="list">
                      {entry.programs.map((program) => (
                        <li class="academic-program">
                          <div class="program-heading">
                            <p class="entry-role">{program.degree}</p>
                            <p class="entry-date">{program.dateRange}</p>
                          </div>
                          {program.summary && <p class="program-summary">{program.summary}</p>}
                          {program.advisor && (
                            <p class="entry-contact">
                              <span>{lang === "en" ? "Advisor" : "导师"}: </span>
                              <a class="text-link" href={program.advisor.link} target="_blank" rel="noopener noreferrer">{program.advisor.name}</a>
                              <span> · </span>
                              <a class="text-link" href={program.advisor.labLink} target="_blank" rel="noopener noreferrer">{program.advisor.lab}<span aria-hidden="true">↗</span></a>
                            </p>
                          )}
                          {program.details.length > 0 && (
                            <details class="academic-details">
                              <summary>{journey.academicDetailsLabel}</summary>
                              <ul class="entry-details" role="list">
                                {program.details.map((detail) => <li>{detail}</li>)}
                              </ul>
                            </details>
                          )}
                        </li>
                      ))}
                    </ol>
                  )}
                  {entry.bullets && (
                    <ul class="entry-details" role="list">
                      {entry.bullets.map((bullet) => <li>{bullet}</li>)}
                    </ul>
                  )}
                  {entry.coverage && (
                    <p class="entry-coverage"><a class="text-link" href={entry.coverage.url} target="_blank" rel="noopener noreferrer">{entry.coverage.label}<span aria-hidden="true">↗</span></a></p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .journey-groups {
    display: grid;
    gap: 48px;
  }

  .group-title {
    margin: 0 0 20px;
    color: var(--accent-color);
    font-size: clamp(22px, 2.2vw, 26px);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: .02em;
  }

  .journey-list,
  .academic-programs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .journey-entry {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    align-items: start;
    gap: 28px;
    padding-block: 28px;
    border-top: 1px solid var(--border-primary);
  }

  .journey-entry:last-child {
    padding-bottom: 0;
  }

  .organization-logos {
    display: grid;
    gap: 8px;
  }

  .logo-surface {
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    place-items: center;
    width: 92px;
    height: 92px;
    padding: 12px;
    box-sizing: border-box;
    border-radius: 8px;
    background: #fff;
  }

  .logo-surface img,
  .organization-logo {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    object-fit: contain;
    object-position: center;
    overflow: hidden;
  }

  .logo-surface-round { padding: 14px; }
  .logo-surface-wide { padding: 6px; }

  .entry-content {
    min-width: 0;
  }

  .entry-heading,
  .program-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 8px 24px;
  }

  .organization-name {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(18px, 1.8vw, 21px);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -.02em;
    overflow-wrap: anywhere;
  }

  .organization-name a {
    color: inherit;
    text-decoration: none;
  }

  .organization-name a:hover {
    color: var(--accent-color);
    text-decoration: underline;
  }

  .entry-date {
    margin: 0;
    color: var(--text-tertiary);
    font: 400 14px/1.8 var(--font-mono);
  }

  .entry-affiliation,
  .entry-contact,
  .program-summary {
    margin: 8px 0 0;
    color: var(--text-secondary);
    font-size: 14px;
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .entry-role {
    margin: 8px 0 0;
    color: var(--accent-color);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.8;
  }

  .entry-contact span:first-child {
    color: var(--text-tertiary);
  }

  .academic-programs {
    margin-top: 18px;
  }

  .academic-program + .academic-program {
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border-secondary);
  }

  .program-heading .entry-role {
    margin: 0;
  }

  .academic-details {
    margin-top: 8px;
    font-size: 14px;
  }

  .academic-details summary {
    width: fit-content;
    color: var(--text-tertiary);
    line-height: 1.8;
  }

  .academic-details summary:hover {
    color: var(--accent-color);
  }

  .entry-details {
    display: grid;
    gap: 6px;
    margin: 14px 0 0;
    padding-left: 18px;
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 1.8;
    list-style: disc;
  }

  .entry-details li::marker {
    color: var(--text-muted);
  }

  .academic-details .entry-details {
    margin-top: 8px;
    font-size: 14px;
  }

  .entry-coverage { margin: 12px 0 0; font-size: 14px; line-height: 1.8; }

  @media (max-width: 767px) {
    .journey-groups {
      gap: 36px;
    }

    .journey-entry {
      grid-template-columns: 68px minmax(0, 1fr);
      gap: 18px;
      padding-block: 24px;
    }

    .logo-surface {
      width: 68px;
      height: 68px;
      padding: 9px;
    }

    .logo-surface-round { padding: 10px; }
    .logo-surface-wide { padding: 4px; }

    .entry-heading,
    .program-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: 6px;
    }

    .entry-date {
      grid-row: 1;
    }

    .organization-name {
      font-size: 18px;
    }
  }

  @media (max-width: 420px) {
    .journey-entry {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

  }
</style>
