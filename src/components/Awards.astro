---
import { getSiteConfig } from "../config";
import { ui } from "../i18n/ui";
import type { Lang } from "../config/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const siteConfig = getSiteConfig(lang);
const t = ui[lang];
---

<section id="awards" class="section" aria-labelledby="awards-title">
  <div class="site-container">
    <div class="section-heading">
      <span class="section-index" aria-hidden="true">05</span>
      <h2 id="awards-title" class="section-title">{t.sectionAwards}</h2>
    </div>
    <ul class="award-list" role="list">
      {siteConfig.awards.map((award) => (
        <li class="award">
          {award.date && <p class="award-date">{award.date}</p>}
          <div class="award-content">
            <h3 class="award-title">
              {award.link ? (
                <a href={award.link} target="_blank" rel="noopener noreferrer" class="text-link">
                  {award.title}<span class="award-arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                award.title
              )}
            </h3>
            {award.description && (
              <p class="award-description">{award.description}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .award-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .award {
    display: grid;
    grid-template-columns: minmax(160px, 0.3fr) minmax(0, 1fr);
    gap: 40px;
    padding: 22px 0;
    border-top: 1px solid var(--border-primary);
  }

  .award:last-child {
    padding-bottom: 0;
  }

  .award-date {
    margin: 2px 0 0;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.8;
  }

  .award-content {
    grid-column: 2;
    min-width: 0;
  }

  .award-title {
    margin: 0;
    color: var(--text-primary);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.6;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .award-arrow {
    display: inline-block;
    margin-left: 8px;
    color: var(--accent-color);
    font-size: 0.875rem;
  }

  .award-description {
    margin: 6px 0 0;
    color: var(--text-secondary);
    font-size: 0.8125rem;
    line-height: 1.8;
  }

  @media (max-width: 767px) {
    .award {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }

    .award-content {
      grid-column: 1;
    }

    .award-date {
      margin-top: 0;
    }
  }
</style>
