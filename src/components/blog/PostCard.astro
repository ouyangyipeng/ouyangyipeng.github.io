---
import type { Lang } from "../../config/types";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: string;
  tags?: string[];
  cover?: string;
  slug: string;
  lang: Lang;
}

const { title, description, pubDate, category, tags, cover, slug, lang } = Astro.props;
const prefix = lang === "zh" ? "/zh/blog" : "/blog";
const locale = lang === "zh" ? "zh-CN" : "en-US";

const formattedDate = pubDate.toLocaleDateString(locale, {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<a href={`${prefix}/${slug}`} class:list={["post-card", cover && "post-card-with-cover"]}>
  {cover && (
    <div class="post-card-cover">
      <img src={cover} alt="" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="post-card-plain">
    <div class="post-card-meta">
      <span class="post-card-category">{category}</span>
      <time datetime={pubDate.toISOString()}>{formattedDate}</time>
    </div>
    <h2 class="post-card-title">{title}</h2>
    <p class="post-card-excerpt">{description}</p>
    {tags && tags.length > 0 && (
      <div class="post-card-tags">
        {tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
      </div>
    )}
  </div>
</a>
