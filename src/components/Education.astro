---
import { getSiteConfig } from "../config";
import { ui } from "../i18n/ui";
import type { Lang } from "../config/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const siteConfig = getSiteConfig(lang);
const t = ui[lang];
---

<section id="education" class="section" aria-labelledby="education-title">
  <div class="site-container">
    <div class="section-heading">
      <span class="section-index" aria-hidden="true">06</span>
      <h2 id="education-title" class="section-title">{t.sectionEducation}</h2>
    </div>
    <ol class="education-list" role="list">
      {siteConfig.education.map((edu) => (
        <li class="education">
          <p class="education-date">{edu.dateRange}</p>
          <div class="education-content">
            <h3 class="education-school">
              {edu.link ? (
                <a href={edu.link} target="_blank" rel="noopener noreferrer" class="text-link">
                  {edu.school}
                </a>
              ) : (
                edu.school
              )}
            </h3>
            <p class="education-degree">{edu.degree}</p>
            {edu.achievements.length > 0 && (
              <ul class="education-details" role="list">
                {edu.achievements.map((achievement) => <li>{achievement}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .education-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .education {
    display: grid;
    grid-template-columns: minmax(160px, 0.3fr) minmax(0, 1fr);
    gap: 40px;
    padding: 32px 0;
    border-top: 1px solid var(--border-primary);
  }

  .education:last-child {
    padding-bottom: 0;
  }

  .education-date {
    margin: 4px 0 0;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.8;
  }

  .education-content {
    min-width: 0;
  }

  .education-school {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .education-degree {
    margin: 8px 0 0;
    color: var(--accent-color);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.7;
  }

  .education-details {
    display: grid;
    gap: 8px;
    margin: 18px 0 0;
    padding: 0;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.85;
    list-style: none;
  }

  .education-details li {
    position: relative;
    padding-left: 16px;
  }

  .education-details li::before {
    position: absolute;
    top: 0.85em;
    left: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-muted);
    content: "";
  }

  @media (max-width: 767px) {
    .education {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
      padding: 28px 0;
    }

    .education-date {
      margin-top: 0;
    }

    .education-school {
      font-size: 1.125rem;
    }
  }
</style>
