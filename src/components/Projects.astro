---
import { getProjects } from "../config/projects";
import type { Lang } from "../config/types";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const projects = getProjects(lang).filter(project => !project.presentation);
---

<section id="projects" class="other-projects" aria-labelledby="projects-title">
  <h3 id="projects-title" class="group-title">{lang === "en" ? "Other projects" : "其他项目"}</h3>
  <ol class="project-list" role="list">
    {projects.map((project, index) => (
      <li class="project">
        <span class="project-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <h4 class="project-title">
          {project.link ? (
            <a href={project.link} target="_blank" rel="noopener noreferrer">
              <span>{project.name}</span>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ) : (
            project.name
          )}
        </h4>
        <p class="project-description">{project.description}</p>
        {(project.role || project.level) && (
          <div class="project-details">
            {project.role && <p class="project-role">{project.role}</p>}
            {project.level && <p class="project-level">{project.level}</p>}
          </div>
        )}
        <ul class="project-skills" role="list">
          {project.skills.map((skill) => <li>{skill}</li>)}
        </ul>
        {project.homepage && (
          <a class="project-homepage text-link" href={project.homepage} target="_blank" rel="noopener noreferrer">
            {lang === "en" ? "Project website" : "项目主页"}<span aria-hidden="true">↗</span>
          </a>
        )}
      </li>
    ))}
  </ol>
</section>

<style>
  .other-projects {
    margin-top: 72px;
    scroll-margin-top: 96px;
  }

  .group-title {
    margin: 0 0 28px;
    color: var(--text-tertiary);
    font: 12px/1.7 var(--font-mono);
    font-weight: 400;
    letter-spacing: 0.04em;
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 64px;
    row-gap: 48px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    min-width: 0;
    padding-top: 24px;
    border-top: 1px solid var(--border-primary);
  }

  .project-number {
    display: block;
    margin-bottom: 14px;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  .project-title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }

  .project-title a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    color: inherit;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .project-title a:hover {
    color: var(--accent-color);
  }

  .project-arrow {
    flex-shrink: 0;
    color: var(--accent-color);
    font-size: 1.125rem;
  }

  .project-description {
    margin: 16px 0 20px;
    color: var(--text-secondary);
    font-size: 0.9375rem;
    line-height: 1.85;
  }

  .project-details {
    display: grid;
    gap: 5px;
    margin-bottom: 16px;
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .project-details p {
    margin: 0;
  }

  .project-role {
    color: var(--text-primary);
    font-weight: 500;
  }

  .project-level {
    color: var(--accent-color);
  }

  .project-skills {
    display: flex;
    flex-wrap: wrap;
    column-gap: 16px;
    row-gap: 4px;
    margin: 0;
    padding: 0;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.8;
    list-style: none;
  }

  .project-skills li {
    overflow-wrap: anywhere;
  }

  .project-homepage {
    display: inline-flex;
    margin-top: 18px;
    font-size: 13px;
  }

  @media (max-width: 767px) {
    .other-projects {
      margin-top: 48px;
    }

    .project-list {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 32px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-title a {
      transition: none;
    }
  }
</style>
