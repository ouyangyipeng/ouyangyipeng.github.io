---
import type { Lang } from "../config/types";
interface Props { size?: "sm" | "md" | "lg"; class?: string; lang?: Lang; }
const { size = "md", class: className = "", lang = "en" } = Astro.props;
const label = lang === "zh" ? "深色模式" : "Dark mode";
---
<button type="button" data-theme-toggle class:list={["theme-toggle", `size-${size}`, className]} aria-label={label} aria-pressed="false" title={label}>
  <svg class="icon-sun" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/>
  </svg>
  <svg class="icon-moon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
    <path d="M20.8 13a9 9 0 0 1-9.8-9.8A9 9 0 1 0 20.8 13Z"/>
  </svg>
</button>
<style>
  .theme-toggle { display: inline-flex; align-items: center; justify-content: center; border: 1px solid var(--border-primary); border-radius: 50%; background: transparent; color: var(--text-secondary); width: 40px; height: 40px; flex-shrink: 0; transition: background .2s, color .2s; }
  .theme-toggle:hover { background: var(--accent-soft); color: var(--accent-color); }
  .size-sm { width: 36px; height: 36px; }
  .size-lg { width: 44px; height: 44px; }
  .icon-sun { display: none; }
  :global(html.dark) .icon-sun { display: block; }
  :global(html.dark) .icon-moon { display: none; }
</style>
<script>
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]");
  let userTheme: string | null = null;
  try { userTheme = localStorage.getItem("theme"); }
  catch { console.warn("Theme preference storage is unavailable."); }
  function applyTheme(dark: boolean): void {
    root.classList.toggle("dark", dark);
    buttons.forEach(button => button.setAttribute("aria-pressed", String(dark)));
  }
  applyTheme(userTheme === "dark");
  buttons.forEach(button => button.addEventListener("click", () => {
    const dark = !root.classList.contains("dark");
    userTheme = dark ? "dark" : "light";
    applyTheme(dark);
    try { localStorage.setItem("theme", userTheme); }
    catch { console.warn("Theme changed for this page; preference could not be saved."); }
  }));
  window.addEventListener("storage", event => {
    if (event.key !== "theme" && event.key !== null) return;
    userTheme = event.newValue;
    applyTheme(userTheme === "dark");
  });
</script>
